# Datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/calistrack
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false
SPRING_FLYWAY_ENABLED=false

# Firebase
FIREBASE_API_KEY=
# FIREBASE_CONFIG_BASE64=

# Swagger server dropdown (Render: https://calistrack-backend.onrender.com)
# OPENAPI_SERVER_URL=https://calistrack-backend.onrender.com
# OPENAPI_LOCAL_SERVER_URL=http://localhost:8084

# CORS (Render — allow GitHub Pages)
# APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,https://*.github.io

# Media — switch provider without code changes: local | cloudinary | aws
MEDIA_PRIMARY_PROVIDER=local

# Cloudinary (set CLOUDINARY_ENABLED=true and MEDIA_PRIMARY_PROVIDER=cloudinary)
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=calistrack
CLOUDINARY_UPLOAD_PRESET=

# AWS S3 (set AWS_S3_ENABLED=true and MEDIA_PRIMARY_PROVIDER=aws)
AWS_S3_ENABLED=false
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_KEY_PREFIX=calistrack/
# AWS_S3_ENDPOINT=   # optional (LocalStack / MinIO)

# Local provider (dev only — keep false on Render/Docker when using Cloudinary)
MEDIA_LOCAL_ENABLED=true
MEDIA_LOCAL_BASE_PATH=./media-uploads
MEDIA_LOCAL_PUBLIC_BASE_URL=http://localhost:8084/api/v1/media/local
MEDIA_MAX_FILE_SIZE_BYTES=52428800

# Keep-alive (Render free tier). Without this, first request after idle can take 5–30s.
# KEEP_ALIVE_ENABLED=true
# KEEP_ALIVE_BASE_URL=https://calistrack-backend.onrender.com
# KEEP_ALIVE_PROVIDER=render
# KEEP_ALIVE_INTERVAL=10m
# KEEP_ALIVE_WINDOW_START=05:00
# KEEP_ALIVE_WINDOW_END=23:00
# KEEP_ALIVE_TIME_ZONE=Asia/Kolkata
